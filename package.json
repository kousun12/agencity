{
  "name": "@prime-agent/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agencity": "./src/cli.ts",
    "prime-agent-ts": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./storage": "./src/storage/index.ts",
    "./artifacts": "./src/artifacts/index.ts",
    "./executors": "./src/executors/index.ts",
    "./console": "./src/console/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./security": "./src/security/index.ts",
    "./tui": "./src/tui/index.ts",
    "./sync": "./src/sync/index.ts",
    "./placement": "./src/placement/index.ts"
  },
  "scripts": {
    "test": "bun run test:core && bun run test:acceptance",
    "test:unit": "bun test --parallel=4 test/unit",
    "test:integration": "bun test --parallel=4 test/integration",
    "test:e2e": "bun test test/e2e",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run check:architecture && bun run test:core && bun run test:acceptance",
    "start": "bun run src/cli.ts",
    "check:architecture": "bun run scripts/check-architecture.ts",
    "test:turso-official": "bun test --timeout 90000 test/slice4/official-server-conformance.test.ts",
    "dev": "bun run src/cli.ts",
    "benchmark:context-efficiency": "bun run scripts/agent-context-efficiency-benchmark.ts",
    "test:core": "bun test --timeout 30000 --parallel=4 test/unit test/integration test/slice2 test/slice3 test/slice3-adversarial test/slice4 test/placement && bun run test:e2e",
    "test:acceptance": "bun test --timeout 120000 --parallel=4 test/acceptance",
    "test:acceptance:external": "AGENCITY_ACCEPTANCE_REAL_PROVIDER=1 bun test --timeout 120000 test/acceptance/external-provider.test.ts",
    "test:acceptance:matrix": "bun run scripts/release-acceptance-matrix.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.36",
    "@ai-sdk/gateway": "4.0.46",
    "@ai-sdk/openai": "4.0.36",
    "@libsql/client": "^0.15.15",
    "@opentui/core": "^0.5.1",
    "@tursodatabase/sync": "0.7.2",
    "ai": "7.0.58",
    "typescript": "^5.9.3",
    "ulid": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
